{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Terminal Flow",
  "mainBinaryName": "dashboard",
  "version": "0.1.0",
  "identifier": "com.claudeterminalflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Claude Terminal Flow", "width": 1100, "height": 700 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
